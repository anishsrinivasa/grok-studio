{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grok-studio:setup-config:1.0",
  "title": "grok-studio setup configuration",
  "description": "Declarative setup flow definitions, with role-contributed questions and capability resolution.",
  "type": "object",
  "required": ["version", "stages", "checks", "questionWidgets", "welcomeTemplate"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/autoStep" },
                { "$ref": "#/$defs/manualStep" },
                { "$ref": "#/$defs/questionStep" },
                { "$ref": "#/$defs/conditionalStep" }
              ]
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["command", "successPattern"],
        "properties": {
          "command": { "type": "string" },
          "successPattern": { "type": "string" },
          "timeout": { "type": "integer" }
        }
      }
    },
    "questionWidgets": {
      "type": "object",
      "description": "UI widget definitions for hosts that support in-chat UI.",
      "properties": {
        "choice": { "type": "object" },
        "yesNo": { "type": "object" },
        "multiSelect": { "type": "object" }
      }
    },
    "welcomeTemplate": {
      "type": "string",
      "description": "Path to the welcome message template file."
    }
  },
  "$defs": {
    "autoStep": {
      "type": "object",
      "required": ["type", "id", "description", "action"],
      "properties": {
        "type": { "const": "auto" },
        "id": { "type": "string" },
        "description": { "type": "string" },
        "action": { "type": "string" },
        "retryOn": { "type": "array", "items": { "type": "string" } }
      }
    },
    "manualStep": {
      "type": "object",
      "required": ["type", "id", "what", "why", "location"],
      "properties": {
        "type": { "const": "manual" },
        "id": { "type": "string" },
        "what": { "type": "string" },
        "why": { "type": "string" },
        "location": { "type": "string" },
        "verify": { "type": "string", "description": "Check command after user confirms done." }
      }
    },
    "questionStep": {
      "type": "object",
      "required": ["type", "id", "prompt"],
      "properties": {
        "type": { "const": "question" },
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "widgetType": { "enum": ["choice", "yes-no", "multi-select"] },
        "options": { "type": "array", "items": { "type": "string" } },
        "default": {},
        "role": { "type": "string", "description": "Role id that contributes this question." }
      }
    },
    "conditionalStep": {
      "type": "object",
      "required": ["type", "condition", "then"],
      "properties": {
        "type": { "const": "conditional" },
        "condition": { "type": "string" },
        "then": {
          "oneOf": [
            { "$ref": "#/$defs/autoStep" },
            { "$ref": "#/$defs/manualStep" },
            { "$ref": "#/$defs/questionStep" }
          ]
        },
        "else": {
          "oneOf": [
            { "$ref": "#/$defs/autoStep" },
            { "$ref": "#/$defs/manualStep" },
            { "$ref": "#/$defs/questionStep" }
          ]
        }
      }
    }
  }
}
