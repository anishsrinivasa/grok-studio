{
  "mcpServers": {
    "roblox-studio": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/studio-mcp.mjs"]
    },
    "blender": {
      "command": "uvx",
      "args": ["mcp-for-blender"],
      "env": {
        "BLENDER_MCP_SAFE_MODE": "1"
      }
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
