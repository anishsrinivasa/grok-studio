# Required: generate with `openssl rand -hex 32`
BRIDGE_TOKEN=

# Server port (default 8787)
PORT=8787

# Roblox Studio MCP command (default: cmd.exe)
RBX_MCP_COMMAND=cmd.exe

# Arguments passed to RBX_MCP_COMMAND (default: /c %LOCALAPPDATA%\Roblox\mcp.bat)
RBX_MCP_ARGS=/c %LOCALAPPDATA%\Roblox\mcp.bat

# Set to 1 to pass --verbose to StudioMCP.exe for debug logging
RBX_MCP_VERBOSE=

# Your ngrok static domain (e.g. my-domain.ngrok-free.app)
NGROK_DOMAIN=
